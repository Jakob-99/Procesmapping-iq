// Corner IQ — interview-platform
// Datamodellen er lille med vilje: en organisation har respondenter (folk man
// kan interviewe), interview-agenter (navngivne, genbrugelige interview-
// definitioner) og interview-runder (navngivne samlinger man opretter først
// og sender ind i). Et interview binder alle tre sammen (agent + respondent +
// runde) og gemmer samtalen + noter.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- Organisation

model Organization {
  id          String       @id @default(cuid())
  name        String
  industry    String?
  createdAt   DateTime     @default(now())
  users       User[]
  engagements Engagement[]
}

model User {
  id             String       @id @default(cuid())
  email          String
  name           String
  title          String?
  role           String // FDE | PROCESS_OWNER | EMPLOYEE | CUSTOMER_LEAD | PARTNER
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  // Sat når rækken er en konsulents eget "sæde" i denne kunde-organisation
  // (se openCustomerAsConsultant i app/admin/actions.ts), ikke en rigtig
  // medarbejder — udelukker rækken fra det almindelige mail-login
  // (ensureLoginCode), så en konsulents mail ikke skygger for en kundes.
  consultantAccountId String?
  consultantAccount   ConsultantAccount? @relation(fields: [consultantAccountId], references: [id], onDelete: SetNull)

  loginTokens    LoginToken[]
  sentInterviews Interview[]  @relation("InterviewSentBy")

  // Mail er kun unik PR. organisation, ikke globalt — en konsulent kan have
  // sit eget sæde hos flere kunder med samme mail.
  @@unique([organizationId, email])
}

// Magic-link login: medarbejderen får en mail med et engangslink.
model LoginToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// --------------------------------------------------------- Konsulentpanel (admin)

// En Cornerstones-konsulent der kan logge ind i admin-panelet — adskilt fra
// User (kundens egne medarbejdere/procesejere). Aldrig tilgængelig fra
// kundefladen; eget login, egen cookie, egen /admin-rute.
model ConsultantAccount {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  title     String?
  role      String   @default("ADMIN") // ADMIN | CONSULTANT — rollestyring udbygges senere
  createdAt DateTime @default(now())

  loginTokens   ConsultantLoginToken[]
  access        ConsultantEngagementAccess[]
  auditLogs     AdminAuditLog[]
  customerSeats User[]
}

// Samme magic-kode-mønster som LoginToken (se lib/interview-auth.ts) — egen
// model fordi den hører til ConsultantAccount, ikke User.
model ConsultantLoginToken {
  id           String            @id @default(cuid())
  token        String            @unique
  consultantId String
  consultant   ConsultantAccount @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime          @default(now())
}

// Hvilken konsulent har adgang til hvilket engagement — en konsulent kan
// have flere kunder, en kunde kan have flere konsulenter tilknyttet.
model ConsultantEngagementAccess {
  id           String            @id @default(cuid())
  consultantId String
  consultant   ConsultantAccount @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  engagementId String
  engagement   Engagement        @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  createdAt    DateTime          @default(now())

  @@unique([consultantId, engagementId])
}

// Log over hvad konsulenter foretager sig af tunge/følsomme handlinger i
// admin-panelet — hvem oprettede en kunde, gav/fjernede adgang, eller åbnede
// kundefladen som en bestemt bruger. Ingen håndhævelse, kun sporbarhed.
model AdminAuditLog {
  id           String            @id @default(cuid())
  consultantId String
  consultant   ConsultantAccount @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  action       String // CREATE_CUSTOMER | GRANT_ACCESS | REVOKE_ACCESS | IMPERSONATE | INVITE_CONSULTANT | REMOVE_CONSULTANT
  targetType   String? // Engagement | User | ConsultantAccount
  targetId     String?
  detail       String?
  createdAt    DateTime          @default(now())
}

// ------------------------------------------------------------------ Engagement

// Ét kundeforløb.
model Engagement {
  id             String       @id @default(cuid())
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  respondents      Respondent[]
  interviewAgents  InterviewAgent[]
  interviewRounds  InterviewRound[]
  interviews       Interview[]
  consultantAccess ConsultantEngagementAccess[]
  themeClusters    ThemeCluster[]
  quotes           Quote[]
  apiKeys          ApiKey[]
}

// En langtidsholdbar service-nøgle der lader en ekstern klient (fx en
// MCP-server en Claude-agent taler med, se app/api/mcp/route.ts) læse ét
// engagements data uden en browser-session. Kun keyHash gemmes — selve
// nøglen vises én gang ved oprettelse (se createApiKey i admin/actions.ts)
// og kan ikke genskabes bagefter, kun tilbagekaldes.
model ApiKey {
  id           String     @id @default(cuid())
  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  name         String
  keyHash      String     @unique
  createdAt    DateTime   @default(now())
  lastUsedAt   DateTime?
  revokedAt    DateTime?
}

// ------------------------------------------------------------- Interview-platform

// En person man kan sende et interview til. Selvstændigt objekt (ikke bundet
// til noget andet i grafen) — matcher ikke en User, for en respondent har
// ikke nødvendigvis nogen login-konto til selve appen.
model Respondent {
  id           String     @id @default(cuid())
  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  name         String
  email        String
  title        String?
  categories   String? // JSON array af forretningsområder — flere pr. respondent, se lib/categories.ts
  notes        String?
  createdAt    DateTime   @default(now())

  loginTokens RespondentLoginToken[]
  interviews  Interview[]

  @@unique([engagementId, email])
}

// Samme 6-cifrede magic-kode-mønster som LoginToken/ConsultantLoginToken —
// egen model fordi Respondent ikke er en User.
model RespondentLoginToken {
  id           String     @id @default(cuid())
  token        String     @unique
  respondentId String
  respondent   Respondent @relation(fields: [respondentId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime   @default(now())
}

// En navngivet, genbrugelig interview-definition — det konsulenten bygger og
// sender ud. Prompten er opdelt i tre felter (formål, prækvalificering,
// hvad der skal undersøges) i stedet for ét frit felt, plus tre 1-5 skalaer
// der styrer agentens stil (opfølgende/formel/spørgsmålslængde).
model InterviewAgent {
  id           String     @id @default(cuid())
  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  name         String

  purpose          String // Hvad er agentens formål
  prequalification String? // Hvad er prækvalificering — hvem/hvad skal være opfyldt før/under interviewet
  investigate      String? // Hvad skal agenten undersøge — konkrete emner/spørgsmål at bore i

  followUpLevel        Int @default(3) // 1-5: hvor opfølgende agenten er
  formalityLevel       Int @default(3) // 1-5: hvor formel tonen er
  questionLengthLevel  Int @default(3) // 1-5: hvor lange/uddybende spørgsmålene er

  createdAt DateTime @default(now())

  // Offentligt selvbetjenings-link (QR/URL) — respondenten opretter sig selv
  // og starter interviewet uden forudgående oprettelse, se joinPublicInterview.
  // Skal pege på en runde, ligesom en almindelig afsendelse — vælges når
  // linket aktiveres.
  publicJoinEnabled Boolean         @default(false)
  publicJoinSlug    String?         @unique
  publicJoinRoundId String?
  publicJoinRound   InterviewRound? @relation(fields: [publicJoinRoundId], references: [id], onDelete: SetNull)

  interviews     Interview[]
  quantQuestions QuantQuestion[]
  images         AgentImage[]
}

// Et billede konsulenten lægger ind ved agentens opsætning (fx en emballage-
// mockup, et koncept-oplæg) — agenten kan referere det ved "label" i sin
// prompt og selv vurdere HVORNÅR under interviewet det er relevant at vise
// det (se showImage i AGENT_TURN_SCHEMA, lib/interview.ts), ikke fast
// placeret et bestemt sted i samtalen.
model AgentImage {
  id               String         @id @default(cuid())
  interviewAgentId String
  interviewAgent   InterviewAgent @relation(fields: [interviewAgentId], references: [id], onDelete: Cascade)
  label            String // kort, unikt reference-navn agenten bruger til at pege på billedet
  data             String // data-URI (base64) — små nok billeder til at ligge i SQLite uden filhåndtering
  sortOrder        Int            @default(0)
  createdAt        DateTime       @default(now())
}

// En navngivet "samling" af afsendte interviews — oprettes FØRST, og vælges
// derefter når man sender interviews ud (sammen med agent + respondenter).
// Gør det muligt at sende samme agent ud flere gange over tid (fx
// "Trivsel Q1", "Trivsel Q2") uden at deres indsigter blandes sammen —
// indsigter (temaer/citater/spørg på tværs) er scoped til runden, ikke
// agenten.
model InterviewRound {
  id           String     @id @default(cuid())
  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  name         String
  createdAt    DateTime   @default(now())

  interviews          Interview[]
  themeClusters       ThemeCluster[]
  publicJoinForAgents InterviewAgent[]
}

// Et fast, sammenligneligt spørgsmål agenten stiller alle respondenter (i
// modsætning til de frie, adaptive AI-probes) — svarene kan aggregeres på
// tværs af interviews under samme agent.
model QuantQuestion {
  id               String         @id @default(cuid())
  interviewAgentId String
  interviewAgent   InterviewAgent @relation(fields: [interviewAgentId], references: [id], onDelete: Cascade)
  prompt           String
  type             String // CHOICE | SCALE
  options          String? // JSON array af muligheder, kun CHOICE
  sortOrder        Int            @default(0)
  createdAt        DateTime       @default(now())

  answers QuantAnswer[]
}

model QuantAnswer {
  id              String        @id @default(cuid())
  quantQuestionId String
  quantQuestion   QuantQuestion @relation(fields: [quantQuestionId], references: [id], onDelete: Cascade)
  interviewId     String
  interview       Interview     @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  value           String // valgt mulighed, eller "1".."5" for scale
  createdAt       DateTime      @default(now())

  @@unique([quantQuestionId, interviewId])
}

// Én afsendt samtale: én agent, én respondent.
model Interview {
  id           String     @id @default(cuid())
  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  interviewAgentId String
  interviewAgent   InterviewAgent @relation(fields: [interviewAgentId], references: [id], onDelete: Cascade)
  respondentId      String
  respondent        Respondent    @relation(fields: [respondentId], references: [id], onDelete: Cascade)

  interviewRoundId String
  interviewRound   InterviewRound @relation(fields: [interviewRoundId], references: [id], onDelete: Cascade)

  // Hvem i organisationen sendte interviewet — kun til visning, ingen logik.
  sentById String?
  sentBy   User?   @relation("InterviewSentBy", fields: [sentById], references: [id], onDelete: SetNull)

  status      String    @default("OPEN") // OPEN | COMPLETED
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  messages     InterviewMessage[]
  notes        InterviewNote[]
  quotes       Quote[]
  quantAnswers QuantAnswer[]
}

model InterviewMessage {
  id          String    @id @default(cuid())
  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  role        String // agent | user
  content     String
  imageLabel  String? // sat når denne agent-tur viste et AgentImage — bruges til at genskabe billedhistorikken ved genoptagelse
  createdAt   DateTime  @default(now())

  quotes Quote[]
}

// Et AI-genereret tema, klynget ud fra InterviewNote på tværs af ALLE
// interviews i én InterviewRound. Regenereres fra bunden ved hvert klik —
// ikke additivt, se generateThemeClusters. Temaerne holdes pr. runde, ikke
// pr. engagement eller agent — to forskellige runder (fx "Trivsel Q1" og
// "Trivsel Q2", begge med samme agent) skal ikke blandes sammen.
model ThemeCluster {
  id               String         @id @default(cuid())
  engagementId     String
  engagement       Engagement     @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  interviewRoundId String
  interviewRound   InterviewRound @relation(fields: [interviewRoundId], references: [id], onDelete: Cascade)
  title            String
  summary          String
  noteIds          String // JSON array af InterviewNote-id'er analysen bygger på
  createdAt        DateTime       @default(now())
}

// Et manuelt udtrukket citat fra en transskription — "quote stitching".
model Quote {
  id           String            @id @default(cuid())
  engagementId String
  engagement   Engagement        @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  interviewId  String
  interview    Interview         @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  messageId    String?
  message      InterviewMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  text         String
  tag          String?
  createdAt    DateTime          @default(now())
}

// Det agenten fandt værd at huske fra interviewet.
model InterviewNote {
  id          String    @id @default(cuid())
  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  category    String // PAIN | WORKAROUND | RISK | KNOWLEDGE | OPPORTUNITY
  content     String
  importance  Int       @default(2) // 1-3
  createdAt   DateTime  @default(now())
}

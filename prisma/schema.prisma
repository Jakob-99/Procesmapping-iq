// Corner IQ — procesmapping
// En organisation har en procesmodel (processer → underprocesser), og hver
// underproces tegnes som et svimlane-diagram: skridt (aktiviteter,
// beslutninger, timere, start/slut) forbundet af pile. Skridtene udføres af
// en rolle eller et system og kobles til de systemer og dataobjekter de
// bruger. Diagrammet redigeres ved at tale med en agent i chatten under det.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- Organisation

model Organization {
  id          String       @id @default(cuid())
  name        String
  industry    String?
  createdAt   DateTime     @default(now())
  users       User[]
  engagements Engagement[]
}

model User {
  id             String       @id @default(cuid())
  email          String
  name           String
  title          String?
  role           String // FDE | PROCESS_OWNER | EMPLOYEE | CUSTOMER_LEAD | PARTNER
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  // Sat når rækken er en konsulents eget "sæde" i denne kunde-organisation
  // (se openCustomerAsConsultant i app/admin/actions.ts), ikke en rigtig
  // medarbejder — udelukker rækken fra det almindelige mail-login
  // (ensureLoginCode), så en konsulents mail ikke skygger for en kundes.
  consultantAccountId String?
  consultantAccount   ConsultantAccount? @relation(fields: [consultantAccountId], references: [id], onDelete: SetNull)

  loginTokens    LoginToken[]
  ownedProcesses Process[]    @relation("ProcessOwner")
  assignedSubs   SubProcess[] @relation("SubProcessOwner")

  // Mail er kun unik PR. organisation, ikke globalt — en konsulent kan have
  // sit eget sæde hos flere kunder med samme mail.
  @@unique([organizationId, email])
}

// Magic-link login: medarbejderen får en mail med et engangslink.
model LoginToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// --------------------------------------------------------- Konsulentpanel (admin)

// En Cornerstones-konsulent der kan logge ind i admin-panelet — adskilt fra
// User (kundens egne medarbejdere/procesejere). Aldrig tilgængelig fra
// kundefladen; eget login, egen cookie, egen /admin-rute.
model ConsultantAccount {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  title     String?
  role      String   @default("CONSULTANT") // ADMIN | CO_LEADER | CONSULTANT — se lib/consultant-roles.ts
  createdAt DateTime @default(now())

  loginTokens   ConsultantLoginToken[]
  access        ConsultantEngagementAccess[]
  auditLogs     AdminAuditLog[]
  customerSeats User[]
}

// Samme magic-kode-mønster som LoginToken (se lib/interview-auth.ts) — egen
// model fordi den hører til ConsultantAccount, ikke User.
model ConsultantLoginToken {
  id           String            @id @default(cuid())
  token        String            @unique
  consultantId String
  consultant   ConsultantAccount @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime          @default(now())
}

// Hvilken konsulent har adgang til hvilket engagement — en konsulent kan
// have flere kunder, en kunde kan have flere konsulenter tilknyttet.
model ConsultantEngagementAccess {
  id           String            @id @default(cuid())
  consultantId String
  consultant   ConsultantAccount @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  engagementId String
  engagement   Engagement        @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  createdAt    DateTime          @default(now())

  @@unique([consultantId, engagementId])
}

// Log over hvad konsulenter foretager sig af tunge/følsomme handlinger i
// admin-panelet — hvem oprettede en kunde, gav/fjernede adgang, eller åbnede
// kundefladen som en bestemt bruger. Ingen håndhævelse, kun sporbarhed.
model AdminAuditLog {
  id           String            @id @default(cuid())
  consultantId String
  consultant   ConsultantAccount @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  action       String // CREATE_CUSTOMER | GRANT_ACCESS | REVOKE_ACCESS | IMPERSONATE | INVITE_CONSULTANT | REMOVE_CONSULTANT | CHANGE_ROLE | PROMOTE_ADMIN
  targetType   String? // Engagement | User | ConsultantAccount
  targetId     String?
  detail       String?
  createdAt    DateTime          @default(now())
}

// ------------------------------------------------------------------ Engagement

// Ét kundeforløb.
model Engagement {
  id             String       @id @default(cuid())
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  consultantAccess ConsultantEngagementAccess[]
  apiKeys          ApiKey[]

  processes     Process[]
  systems       SystemRef[]
  dataObjects   DataObject[]
  businessRoles BusinessRole[]
}

// En langtidsholdbar nøgle til MCP-serveren (app/api/mcp/route.ts), så en
// Claude-agent kan læse engagementets procesmodel uden en browser-session.
// Kun keyHash gemmes — selve nøglen vises én gang ved oprettelse i
// Kontrolpanelet og kan ikke genskabes bagefter, kun tilbagekaldes.
model ApiKey {
  id           String     @id @default(cuid())
  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  name         String
  keyHash      String     @unique
  createdAt    DateTime   @default(now())
  lastUsedAt   DateTime?
  revokedAt    DateTime?
}

// ------------------------------------------------------- Aktører og objekter

// En fast rolle i forretningen — en menneskelig aktør, ikke en systembruger.
// Processkridt udføres af en rolle, ikke af en navngiven person.
model BusinessRole {
  id           String     @id @default(cuid())
  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  createdAt    DateTime   @default(now())

  steps ProcessStep[]
  lanes ProcessLane[] @relation("LaneActorRole")
}

// Et IT-system i landskabet (ERP, CRM, Excel-ark, ...).
model SystemRef {
  id           String     @id @default(cuid())
  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  name         String
  category     String? // ERP | CRM | BI | Fil | Egenudviklet | Andet
  isMasterData Boolean    @default(false)
  // Kan en AI-agent tale direkte med systemet (API, webhook) — eller kræver det et menneske?
  canAgentConnect Boolean @default(false)
  // Integrationsmuligheder, kommasepareret: MANUAL, API, MCP, RPA (se
  // lib/domain.ts). Tom = ikke afklaret. canAgentConnect følger med.
  integrations String @default("")
  notes        String?

  // AI-parathed — de tre forudsætninger for at et systemfundament er
  // berettiget til AI native (se lib/readiness.ts).
  hasOpenApi        Boolean @default(false)
  masterDataQuality String? // GOOD | PARTIAL | POOR
  processesUpToDate Boolean @default(false)
  readinessNotes    String?

  stepLinks StepSystem[]
  dataLinks DataObject[]
  // Skridt der har DETTE system som aktør/svimlane (se ProcessStep.actorSystemId)
  // — adskilt fra stepLinks, som er "systemet bruges i skridtet".
  actorSteps ProcessStep[] @relation("StepActorSystem")
  lanes      ProcessLane[] @relation("LaneActorSystem")
}

// Et forretningsobjekt der flyder gennem processerne (Ordre, Kunde, Faktura...).
model DataObject {
  id             String     @id @default(cuid())
  engagementId   String
  engagement     Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  isMasterData   Boolean    @default(false)
  ownerSystemId  String?
  ownerSystem    SystemRef? @relation(fields: [ownerSystemId], references: [id], onDelete: SetNull)

  stepLinks StepData[]
}

// ------------------------------------------------------------------ Processer

// En end-to-end proces, fx "Order to Cash".
model Process {
  id           String     @id @default(cuid())
  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  // Procesmodellen: kerneprocesser løber gennem forretningen, støtteprocesser bærer dem.
  category     String  @default("CORE") // CORE | SUPPORT
  startEvent   String?
  endEvent     String?
  ownerId      String?
  owner        User?      @relation("ProcessOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())

  subProcesses SubProcess[]
  groups       SubProcessGroup[]
}

// En navngivet gruppe af underprocesser på procesområdets side (fx
// "Rekrutering" under HR). Underprocesser uden gruppe står i en unavngivet
// gruppe øverst.
model SubProcessGroup {
  id        String   @id @default(cuid())
  processId String
  process   Process  @relation(fields: [processId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  subProcesses SubProcess[]
}

// En underproces i en e2e-proces — enheden der tegnes som ét diagram.
model SubProcess {
  id        String  @id @default(cuid())
  processId String
  process   Process @relation(fields: [processId], references: [id], onDelete: Cascade)
  groupId   String?
  group     SubProcessGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  name      String
  // Kort beskrivelse af forløbet — vises som note over diagrammet.
  summary   String?

  inScope     Boolean @default(true)
  scopeReason String?

  assigneeId String?
  assignee   User?   @relation("SubProcessOwner", fields: [assigneeId], references: [id], onDelete: SetNull)

  status String @default("NOT_STARTED") // NOT_STARTED | DRAFT | IN_VALIDATION | VALIDATED | NEEDS_UPDATE

  sortOrder Int      @default(0)
  updatedAt DateTime @updatedAt

  steps        ProcessStep[]
  flows        ProcessFlow[]
  lanes        ProcessLane[]
  pools        ProcessPool[]
  chatMessages ProcessChatMessage[]
  findings     ProcessFinding[]
  notes        ProcessNote[]
}

// En fritstående note på tegnefladen (som en BPMN-tekstannotation).
// x/y er position i pixels i forhold til diagrammets øverste venstre hjørne.
model ProcessNote {
  id           String     @id @default(cuid())
  subProcessId String
  subProcess   SubProcess @relation(fields: [subProcessId], references: [id], onDelete: Cascade)
  text         String     @default("")
  x            Float
  y            Float
  createdAt    DateTime   @default(now())
}

// Analysen under diagrammet: problemer/findings, ønsker og forbedringer, og
// mulige ideer der er diskuteret. Kan skrives i hånden eller noteres af
// proces-agenten fra chatten. stepId kobler punktet til et bestemt skridt.
model ProcessFinding {
  id           String       @id @default(cuid())
  subProcessId String
  subProcess   SubProcess   @relation(fields: [subProcessId], references: [id], onDelete: Cascade)
  kind         String // PROBLEM | WISH | IDEA
  text         String
  stepId       String?
  step         ProcessStep? @relation(fields: [stepId], references: [id], onDelete: SetNull)
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())
}

// En ekstra pool i diagrammet — en selvstændig ramme med egen titel og egne
// svimlaner, typisk en ekstern part (fx "Rekrutteringspartner"), som hoved-
// poolen kun taler med via besked-pile. Hovedpoolen er implicit (titel =
// underprocessens navn) og har ingen række; svimlaner uden poolId ligger i den.
model ProcessPool {
  id           String     @id @default(cuid())
  subProcessId String
  subProcess   SubProcess @relation(fields: [subProcessId], references: [id], onDelete: Cascade)
  name         String
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())

  lanes ProcessLane[]
}

// En svimlane (lodret kolonne i diagrammet). Hver underproces har ALTID
// præcis én isDefault-lane ("Proces", ingen aktør) til skridt uden aktør —
// den kan hverken slettes eller få en aktør. Et skridts faktiske aktør er
// ProcessStep.actorRoleId/actorSystemId; ensureLane opretter lanen med det
// samme, så de to aldrig løber fra hinanden. sortOrder styrer rækkefølgen
// af kolonnerne fra venstre mod højre.
model ProcessLane {
  id           String     @id @default(cuid())
  subProcessId String
  subProcess   SubProcess @relation(fields: [subProcessId], references: [id], onDelete: Cascade)
  isDefault    Boolean    @default(false)
  sortOrder    Int        @default(0)
  poolId       String?
  pool         ProcessPool? @relation(fields: [poolId], references: [id], onDelete: SetNull)

  actorRoleId   String?
  actorRole     BusinessRole? @relation("LaneActorRole", fields: [actorRoleId], references: [id], onDelete: SetNull)
  actorSystemId String?
  actorSystem   SystemRef?    @relation("LaneActorSystem", fields: [actorSystemId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([subProcessId, actorRoleId, actorSystemId])
}

// Ét element i diagrammet. sortOrder er rækken (diagrammet løber nedad),
// svimlanen er aktøren. Nøjagtig ét af actorRoleId/actorSystemId er sat ad
// gangen, aldrig begge — ingen af dem betyder den grundlæggende lane.
model ProcessStep {
  id           String     @id @default(cuid())
  subProcessId String
  subProcess   SubProcess @relation(fields: [subProcessId], references: [id], onDelete: Cascade)

  stepType    String  @default("TASK") // START | END | TASK | DECISION | TIMER
  name        String
  description String?

  actorRoleId   String?
  actorRole     BusinessRole? @relation(fields: [actorRoleId], references: [id], onDelete: SetNull)
  actorSystemId String?
  actorSystem   SystemRef?    @relation("StepActorSystem", fields: [actorSystemId], references: [id], onDelete: SetNull)

  isManual Boolean @default(true)

  decisionCriteria String?
  output           String?
  frequency        String?
  durationMin      Int?
  painPoint        String?
  sortOrder        Int     @default(0)

  systems  StepSystem[]
  data     StepData[]
  findings ProcessFinding[]
  outgoing ProcessFlow[] @relation("FlowFrom")
  incoming ProcessFlow[] @relation("FlowTo")
}

// En pil mellem to skridt. Fra en beslutning har pilene hver sin etiket
// ("Ja"/"Nej", "Ferie"/"Arbejdsdag"). MESSAGE er en stiplet besked-pil til
// en ekstern part, som i BPMN.
model ProcessFlow {
  id           String      @id @default(cuid())
  subProcessId String
  subProcess   SubProcess  @relation(fields: [subProcessId], references: [id], onDelete: Cascade)
  fromStepId   String
  fromStep     ProcessStep @relation("FlowFrom", fields: [fromStepId], references: [id], onDelete: Cascade)
  toStepId     String
  toStep       ProcessStep @relation("FlowTo", fields: [toStepId], references: [id], onDelete: Cascade)
  label        String?
  kind         String      @default("SEQUENCE") // SEQUENCE | MESSAGE

  @@unique([fromStepId, toStepId])
}

model StepSystem {
  id       String      @id @default(cuid())
  stepId   String
  step     ProcessStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  systemId String
  system   SystemRef   @relation(fields: [systemId], references: [id], onDelete: Cascade)
  usage    String? // READ | WRITE | BOTH

  @@unique([stepId, systemId])
}

model StepData {
  id           String      @id @default(cuid())
  stepId       String
  step         ProcessStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  dataObjectId String
  dataObject   DataObject  @relation(fields: [dataObjectId], references: [id], onDelete: Cascade)
  direction    String? // INPUT | OUTPUT | BOTH

  @@unique([stepId, dataObjectId])
}

// Samtalen med proces-agenten under diagrammet. Gemmes så man kan vende
// tilbage og se hvad der er ændret og hvorfor.
model ProcessChatMessage {
  id           String     @id @default(cuid())
  subProcessId String
  subProcess   SubProcess @relation(fields: [subProcessId], references: [id], onDelete: Cascade)
  role         String // user | agent
  content      String
  userName     String?
  createdAt    DateTime   @default(now())
}
